# Shared VHS settings. The theme copies the Oxocarbon palette from
# conf/modules/ghostty/config so recordings match the terminal.

Set Shell zsh
Set FontFamily '"0xProto Nerd Font"'  # quoted: CSS family names cannot start with a digit
Set FontSize 15
Set LineHeight 1.2
Set Width 1280
Set Height 860
Set Padding 24
Set TypingSpeed 45ms
Set Theme { "name": "Oxocarbon", "background": "#1b1b1b", "foreground": "#ffffff", "cursor": "#78a9ff", "selection": "#393939", "black": "#161616", "red": "#ee5396", "green": "#42be65", "yellow": "#ff7eb6", "blue": "#33b1ff", "magenta": "#be95ff", "cyan": "#3ddbd9", "white": "#ffffff", "brightBlack": "#8d8d8d", "brightRed": "#ee5396", "brightGreen": "#42be65", "brightYellow": "#ff7eb6", "brightBlue": "#33b1ff", "brightMagenta": "#be95ff", "brightCyan": "#3ddbd9", "brightWhite": "#ffffff" }
